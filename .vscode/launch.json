{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "main train fno",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "hydra.run.dir=.",
                "hydra.output_subdir=null"
              ],
            "env": {
                "HYDRA_FULL_ERROR": "1",
                "HYDRA_MAIN_DISABLE_RUN": "1"
                }

        },
        {
            "name": "main train unet",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "hydra.run.dir=.",
                "hydra.output_subdir=null",
                "model_config=unet_attn"
              ],
            "env": {
                "HYDRA_FULL_ERROR": "1",
                "HYDRA_MAIN_DISABLE_RUN": "1"
                }

        },
        // default
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": true,
            // add current file
            "program": "${file}", 
            "console": "integratedTerminal",
        }
            ]
}